classDiagram
    class Owner {
        +String name
        +int available_minutes
        +List~Pet~ pets
        +add_pet(pet)
        +update_available_time(minutes)
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +add_task(task)
        +edit_task(description, new_details)
    }

    class Task {
        +String description
        +int duration
        +int priority
        +String pet_name
        +String frequency
        +bool completed
        +Optional~String~ scheduled_time
        +date due_date
        +update_details(description, duration, priority, frequency, scheduled_time)
        +mark_complete()
    }

    class Scheduler {
        +List~Task~ selected_tasks
        +List~Tuple~ skipped_tasks
        +int total_duration
        +int available_minutes
        +generate_plan(owner) List~Task~
        +sort_by_time(tasks) List~Task~
        +filter_tasks(owner, pet_name, completed) List~Task~
        +complete_task(owner, task) Optional~Task~
        +find_conflicts(owner) List~String~
        +explain_choices() String
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : uses get_all_tasks()
    Scheduler "1" --> "0..*" Task : selects
    Scheduler ..> Task : creates next occurrence

    note for Task "priority: 1 = high, 2 = medium, 3 = low; ties keep original order. scheduled_time is HH:MM or None; due_date defaults to today"
    note for Scheduler "skipped_tasks holds (Task, reason) tuples. complete_task() adds the next daily/weekly Task to the same Pet"
